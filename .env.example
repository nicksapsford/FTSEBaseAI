# FTSEBase .env template. Copy to .env (gitignored) per machine.
# Broker credentials (demo/live Capital.com):
CAPITALCOM_EMAIL=
CAPITALCOM_PASSWORD=
CAPITALCOM_API_KEY=
CAPITALCOM_ACC_TYPE=DEMO

# ── Per-machine flags (paper-safe DEFAULTS -- absent = these values) ──
# DELL paper systems: leave BOTH False (fixed stake for clean comparison, silent).
# K1 LIVE systems: set BOTH True before go-live.
USE_COMPOUNDING=False       # True on K1 -> size 2% of CURRENT balance per trade (compounding)
LIVE_NOTIFICATIONS=False    # True on K1 -> Percival Pushover on real-money trades
RISK_PCT=0.02               # 2% of current balance risked per trade
MAX_RISK_PCT=0.05           # hard safety cap
MIN_STAKE=0.50              # Capital.com minimum GBP/pt
